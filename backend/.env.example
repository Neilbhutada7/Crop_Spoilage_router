# Copy this file to .env and fill in real values before running docker-compose up.

# Weather comes from Open-Meteo (https://open-meteo.com) -- no API key
# needed. Falls back to a clearly-labeled synthetic weather generator only
# if Open-Meteo is unreachable or the date is outside its coverage.

# Only needed if running the backend outside docker-compose (compose sets
# this itself to point at the postgres service).
DATABASE_URL=postgresql://spoilage:spoilage@localhost:5432/spoilage_router

# Powers the GPT explanation/conversation layer of the AI Assistant (see
# services/gpt_assistant_service.py). NEVER the spoilage model itself --
# that stays XGBoost regardless of this key. Get a key at
# https://platform.openai.com/api-keys (requires billing set up).
# Leave empty to run the assistant on its built-in rule-based responder
# instead -- the app works fully either way.
# NEVER prefix this with VITE_ or reference it from frontend code -- it
# must only ever be read on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Powers real live mandi prices (services/mandi_price_service.py) from the
# Government of India's Agmarknet daily market-price feed on data.gov.in
# (resource 9ef84268-d588-465a-a308-a864a43d0070). Get a free key at
# https://data.gov.in/user/register. Leave empty to use data.gov.in's own
# published sample key instead -- it works, but is shared publicly and
# rate-limited, so prices may occasionally fail to fetch under load; the
# app always falls back to clearly-labeled seeded prices when that happens.
DATA_GOV_API_KEY=

# Set this when the frontend is deployed on a different domain than the
# backend (e.g. frontend on Vercel, backend on Render) -- required for
# login/signup to work cross-origin (CORS + session cookie settings, see
# app.py). Comma-separate multiple origins. Leave empty for local dev,
# where Flask serves both frontend and backend from the same origin.
FRONTEND_ORIGIN=
